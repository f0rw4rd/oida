<?xml version="1.0" encoding="UTF-8"?>
<!-- Calimero KNXnet/IP server settings for OIDA testing -->
<knxServer name="oida-knx" friendlyName="OIDA KNX Mock Server">
	<discovery listenNetIf="all" outgoingNetIf="all" />
	<serviceContainer activate="true" routing="true" networkMonitoring="true" netif="any" udpPort="3671" securedServices="optional">
		<knxAddress type="individual">1.1.0</knxAddress>
		<knxSubnet type="virtual" medium="pl110" domainAddress="6c">MockNetwork</knxSubnet>
		<groupAddressFilter>
			<!-- Lighting -->
			<knxAddress type="group">1/0/1</knxAddress>
			<knxAddress type="group">1/0/2</knxAddress>
			<knxAddress type="group">1/0/3</knxAddress>
			<!-- Dimming -->
			<knxAddress type="group">1/1/1</knxAddress>
			<knxAddress type="group">1/1/2</knxAddress>
			<!-- Temperature -->
			<knxAddress type="group">2/0/1</knxAddress>
			<knxAddress type="group">2/0/2</knxAddress>
			<knxAddress type="group">2/0/3</knxAddress>
			<!-- Blinds -->
			<knxAddress type="group">3/0/1</knxAddress>
			<knxAddress type="group">3/0/2</knxAddress>
			<!-- HVAC -->
			<knxAddress type="group">4/0/1</knxAddress>
			<!-- Scene -->
			<knxAddress type="group">5/0/1</knxAddress>
		</groupAddressFilter>
		<additionalAddresses>
			<knxAddress type="individual">1.1.10</knxAddress>
			<knxAddress type="individual">1.1.11</knxAddress>
			<knxAddress type="individual">1.1.12</knxAddress>
			<knxAddress type="individual">1.1.13</knxAddress>
			<knxAddress type="individual">1.1.14</knxAddress>
			<knxAddress type="individual">1.1.15</knxAddress>
			<knxAddress type="individual">1.1.16</knxAddress>
			<knxAddress type="individual">1.1.17</knxAddress>
			<knxAddress type="individual">1.1.18</knxAddress>
			<knxAddress type="individual">1.1.19</knxAddress>
			<knxAddress type="individual">1.1.20</knxAddress>
		</additionalAddresses>
	</serviceContainer>
</knxServer>
