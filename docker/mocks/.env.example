# Mock-image registry — copy this file to .env and set your registry.
#
#   cp docker/mocks/.env.example docker/mocks/.env
#   # then edit OIDA_REGISTRY below
#
# .env is gitignored, so the real (private) URL never lands in git.
# OIDA_REGISTRY is REQUIRED: compose/bake fail hard if it is unset — there is
# deliberately no default, so nothing silently pushes/pulls the wrong registry.
#
# Value is the registry + namespace prefix, NO trailing slash. Images become
#   $OIDA_REGISTRY/oida-mock-<service>:latest
#
# Examples:
#   OIDA_REGISTRY=ghcr.io/f0rw4rd                  # public GitHub Container Registry
#   OIDA_REGISTRY=registry.internal.example.com/oida
#   OIDA_REGISTRY=myuser.jfrog.io/oida-mocks
#   OIDA_REGISTRY=123456789.dkr.ecr.eu-central-1.amazonaws.com/oida

OIDA_REGISTRY=ghcr.io/f0rw4rd

# Build & push everything to that registry (after `docker login <registry>`):
#   cd docker/mocks && docker buildx bake -f compose.yml -f compose.cve.yml --push
#
# Pull/run via the service manager picks up .env automatically:
#   python services.py up cve
