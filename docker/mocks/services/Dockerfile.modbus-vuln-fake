# Vulnerable Modbus TCP Server for Fuzzing Demo
#
# This Dockerfile builds a Modbus server with intentional vulnerabilities
# for demonstrating OIDA's crash detection and replay capabilities.
#
# Compiled with security protections DISABLED:
# - No stack canaries (-fno-stack-protector)
# - Executable stack (-z execstack)
# - No PIE (-no-pie)
#
# FOR SECURITY TESTING PURPOSES ONLY

FROM gcc:12-bookworm

WORKDIR /app

# Copy source
COPY modbus/modbus_vuln.c .

# Compile with protections disabled for easy crash detection
# -U_FORTIFY_SOURCE: Disable glibc's fortified functions
# -D_FORTIFY_SOURCE=0: Explicitly disable fortify
RUN gcc -g -O0 \
    -fno-stack-protector \
    -U_FORTIFY_SOURCE \
    -D_FORTIFY_SOURCE=0 \
    -z execstack \
    -no-pie \
    -fcf-protection=none \
    -o modbus_vuln modbus_vuln.c

# Install netcat for healthcheck
RUN apt-get update && apt-get install -y netcat-openbsd && rm -rf /var/lib/apt/lists/*

# Default port
ENV MODBUS_PORT=5020
EXPOSE 5020

CMD ["./modbus_vuln"]
