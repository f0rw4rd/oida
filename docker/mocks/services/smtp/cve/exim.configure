# Minimal Exim runtime configuration for CVE-2019-16928 reproduction.
# Goal: reach the SMTP EHLO command parser. No DNS, no TLS, no auth.

primary_hostname = cve.local
domainlist local_domains = @ : localhost : cve.local
hostlist   relay_from_hosts = 0.0.0.0/0

disable_ipv6 = true
acl_smtp_rcpt = acl_check_rcpt
acl_smtp_data = acl_check_data

# No real delivery routing needed; everything routes to the local sink.
never_users =

# Keep the daemon quiet about retries / DNS.
host_lookup =
rfc1413_hosts =
rfc1413_query_timeout = 0s

begin acl

acl_check_rcpt:
  accept

acl_check_data:
  accept

begin routers

sink_router:
  driver = accept
  transport = sink_transport

begin transports

sink_transport:
  driver = appendfile
  file = /dev/null
  user = exim
  delivery_date_add
  envelope_to_add
  return_path_add

begin retry
*  *  F,2h,15m; G,16h,1h,1.5; F,4d,6h
