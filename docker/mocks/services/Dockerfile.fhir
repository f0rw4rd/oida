# FHIR R4 Mock Server for OIDA Testing
FROM python:3.11-slim

LABEL maintainer="OIDA Security Testing Framework"
LABEL description="Mock FHIR R4 REST API server for security testing"

# Set working directory
WORKDIR /app

# No additional Python dependencies needed - using stdlib only
# Copy server script
COPY fhir_server.py /app/

# Expose FHIR port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/fhir/metadata', timeout=2)" || exit 1

# Run server
CMD ["python3", "/app/fhir_server.py"]
