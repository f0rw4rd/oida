FROM python:3.11-slim

WORKDIR /app

# Install openssl for self-signed cert generation and Python dependencies
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir hl7apy>=1.3.4 cryptography>=41.0.0

# Copy server script
COPY hl7_server.py /app/

# Expose MLLP and MLLPS ports
EXPOSE 2575 2576

# Run server
CMD ["python3", "hl7_server.py"]
