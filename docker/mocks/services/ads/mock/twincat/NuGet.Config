<!-- Restore the official Beckhoff TwinCAT.Ads packages from public nuget.org only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
