<!--
  SPDX-License-Identifier: MIT
  OIDA TwinCAT ADS/AMS mock.
  Uses the official Beckhoff TwinCAT.Ads .NET packages (MIT, (c)Beckhoff
  Automation 2024). Architecture derived from the 0BSD-licensed
  Beckhoff/TF6000_ADS_DOTNET_V5_Samples (RouterSamples, DockerSamples,
  ServerSamples/AdsSymbolicServerSample).
  Packages are restored from nuget.org at build time; no binaries committed.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OidaTwinCatMock</RootNamespace>
    <AssemblyName>OidaTwinCatMock</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Usermode AMS/TCP router (no TwinCAT install required) -->
    <PackageReference Include="Beckhoff.TwinCAT.Ads.TcpRouter" Version="6.2.*" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads.SystemServer" Version="6.2.*" />
    <!-- Symbolic ADS server (handles symbol upload / handle / read-by-name) -->
    <PackageReference Include="Beckhoff.TwinCAT.Ads.SymbolicServer" Version="6.2.*" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads.Abstractions" Version="6.2.*" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads.ConfigurationProviders" Version="6.2.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
