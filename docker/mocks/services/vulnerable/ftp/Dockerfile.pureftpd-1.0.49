# Pure-FTPd 1.0.49 - CVE-2020-9365 (Out-of-Bounds Read)
# OOB read in pure_strcmp function in utils.c
# Reference: https://securitylab.github.com/advisories/GHSL-2020-032-PureFTPD/
#
# VULNERABLE: Long username during authentication triggers OOB read
# Affects: Pure-FTPd 1.0.38 through 1.0.49
#
# For authorized security testing only

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Download and compile vulnerable Pure-FTPd 1.0.49
WORKDIR /tmp
RUN wget -q https://github.com/jedisct1/pure-ftpd/releases/download/1.0.49/pure-ftpd-1.0.49.tar.gz \
    && tar xzf pure-ftpd-1.0.49.tar.gz \
    && cd pure-ftpd-1.0.49 \
    && ./configure --prefix=/usr/local \
        --without-privsep \
        CFLAGS="-fno-stack-protector -fsanitize=address -g -O0" \
        LDFLAGS="-fsanitize=address" \
    && make -j$(nproc) \
    && make install \
    && cd / && rm -rf /tmp/*

# Create FTP user
RUN useradd -m -d /var/ftp -s /bin/false ftpuser \
    && echo "ftpuser:ftpuser" | chpasswd \
    && mkdir -p /var/ftp/pub \
    && chown -R ftpuser:ftpuser /var/ftp

# Create startup script
RUN cat > /start.sh << 'EOF'
#!/bin/sh
echo "Starting Pure-FTPd 1.0.49 (CVE-2020-9365 vulnerable)"
echo "WARNING: This server is intentionally vulnerable for security testing"
exec /usr/local/sbin/pure-ftpd -S 2123 -B -l unix -E
EOF
RUN chmod +x /start.sh

EXPOSE 2123

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD nc -zv localhost 2123 || exit 1

CMD ["/start.sh"]
