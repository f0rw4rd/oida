# wu-ftpd 2.6.2 - CVE-2004-0185 (S/Key Buffer Overflow) - SIMULATED
# Stack buffer overflow in skey_challenge function in ftpd.c
# Reference: https://www.cvedetails.com/cve/CVE-2004-0185/
#
# VULNERABLE: Long username in S/Key authentication causes stack overflow
# Affects: wu-ftpd 2.6.2 and earlier with S/Key enabled
#
# For authorized security testing only

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create simulated vulnerable wu-ftpd with S/Key overflow
COPY wuftpd_skey.c /tmp/wuftpd_skey.c
RUN gcc -fno-stack-protector -z execstack -no-pie -g -o /usr/local/sbin/wuftpd_skey /tmp/wuftpd_skey.c \
    && rm /tmp/wuftpd_skey.c

# Create startup script
RUN printf '#!/bin/sh\necho "Starting wu-ftpd 2.6.2 simulator (CVE-2004-0185 S/Key vulnerable)"\necho "WARNING: This server is intentionally vulnerable for security testing"\nexec /usr/local/sbin/wuftpd_skey\n' > /start.sh \
    && chmod +x /start.sh

EXPOSE 2125

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD nc -zv localhost 2125 || exit 1

CMD ["/start.sh"]
