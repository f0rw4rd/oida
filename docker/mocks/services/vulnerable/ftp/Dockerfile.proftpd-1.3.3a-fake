# ProFTPD 1.3.3a - CVE-2010-4221 (Telnet IAC Stack Buffer Overflow) - SIMULATED
# Stack-based buffer overflow in pr_netio_telnet_gets function
# Reference: https://www.exploit-db.com/exploits/16851
#
# VULNERABLE: Sending large number of Telnet IAC (0xFF) commands causes stack overflow
# Affects: ProFTPD 1.3.2rc3 through 1.3.3b
#
# For authorized security testing only

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY proftpd_iac.c /tmp/proftpd_iac.c
RUN gcc -fno-stack-protector -z execstack -no-pie -g -o /usr/local/sbin/proftpd_sim /tmp/proftpd_iac.c \
    && rm /tmp/proftpd_iac.c

RUN printf '#!/bin/sh\necho "Starting ProFTPD 1.3.3a simulator (CVE-2010-4221 vulnerable)"\necho "WARNING: This server is intentionally vulnerable for security testing"\nexec /usr/local/sbin/proftpd_sim\n' > /start.sh \
    && chmod +x /start.sh

EXPOSE 2127

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD nc -zv localhost 2127 || exit 1

CMD ["/start.sh"]
