# ProFTPD 1.3.0 - CVE-2006-5815 (sreplace Stack Buffer Overflow) - SIMULATED
# Stack-based buffer overflow in sreplace function in src/support.c
# Reference: https://www.exploit-db.com/exploits/16852
#
# VULNERABLE: .message file with many %C patterns triggers sreplace overflow
# Affects: ProFTPD 1.2.x through 1.3.0
#
# For authorized security testing only

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY proftpd_sreplace.c /tmp/proftpd_sreplace.c
RUN gcc -fno-stack-protector -z execstack -no-pie -g -o /usr/local/sbin/proftpd_sreplace /tmp/proftpd_sreplace.c \
    && rm /tmp/proftpd_sreplace.c

RUN printf '#!/bin/sh\necho "Starting ProFTPD 1.3.0 simulator (CVE-2006-5815 vulnerable)"\necho "WARNING: This server is intentionally vulnerable for security testing"\nexec /usr/local/sbin/proftpd_sreplace\n' > /start.sh \
    && chmod +x /start.sh

EXPOSE 2128

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD nc -zv localhost 2128 || exit 1

CMD ["/start.sh"]
