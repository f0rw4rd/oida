# REAL CVE-2017-15105 - Actual vulnerable Unbound v1.6.4
#
# This builds the real Unbound at the vulnerable version.
# CVE-2017-15105: Wildcard synthesis bypass allows cache poisoning

FROM debian:bullseye

RUN apt-get update && apt-get install -y \
    git build-essential autoconf automake libtool pkg-config \
    libssl-dev libexpat1-dev libevent-dev bison flex \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone Unbound and checkout vulnerable version 1.6.4
RUN git clone https://github.com/NLnetLabs/unbound.git && \
    cd unbound && \
    git checkout release-1.6.4 && \
    ./configure --prefix=/usr \
                --with-libevent \
                --disable-flto \
                CFLAGS="-g -O0 -fno-stack-protector" && \
    make -j$(nproc) && \
    make install

# Create configuration
RUN mkdir -p /etc/unbound && \
    cat > /etc/unbound/unbound.conf << 'EOF'
server:
    interface: 0.0.0.0
    port: 5055
    access-control: 0.0.0.0/0 allow
    do-ip6: no
    verbosity: 2
    log-queries: yes
    val-permissive-mode: yes
    cache-max-ttl: 86400
    chroot: ""
    username: ""

forward-zone:
    name: "."
    forward-addr: 8.8.8.8
EOF

RUN cat > /start.sh << 'SCRIPT'
#!/bin/sh
echo "=============================================="
echo "  REAL Unbound 1.6.4 - CVE-2017-15105"
echo "  Port: 5055/udp"
echo "  Vuln: Wildcard NSEC cache poisoning"
echo "=============================================="
exec /usr/sbin/unbound -d -c /etc/unbound/unbound.conf
SCRIPT
RUN chmod +x /start.sh

EXPOSE 5055/tcp
EXPOSE 5055/udp
CMD ["/start.sh"]
