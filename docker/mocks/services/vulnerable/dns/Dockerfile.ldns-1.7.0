# REAL CVE-2017-1000231/1000232 - Actual vulnerable ldns v1.7.0
#
# This builds the real ldns library at the vulnerable version
# and links against it. The crash happens in library code.
#
# CVE-2017-1000231: Heap overflow in ldns_rr_new_frm_str_internal()
# CVE-2017-1000232: Heap overflow in ldns_str2rdf_long_str()

FROM debian:bullseye

RUN apt-get update && apt-get install -y \
    git build-essential autoconf automake libtool pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone ldns and checkout vulnerable version 1.7.0
RUN git clone https://github.com/NLnetLabs/ldns.git && \
    cd ldns && \
    git checkout release-1.7.0 && \
    libtoolize -ci && \
    autoreconf -fi && \
    ./configure --prefix=/usr --disable-dane-verify && \
    make CFLAGS="-g -O0 -fno-stack-protector" -j$(nproc) && \
    make install && \
    ldconfig

WORKDIR /app
RUN cat > server.c << 'EOF'
/**
 * DNS Server using ldns 1.7.0 (CVE-2017-1000231/1000232)
 * Vulnerability is in the REAL ldns library
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <ldns/ldns.h>

#define PORT 5053

int main(void) {
    int sockfd;
    struct sockaddr_in addr, client;
    socklen_t client_len = sizeof(client);
    uint8_t buffer[65535];

    setbuf(stdout, NULL);
    printf("=====================================================\n");
    printf("  REAL ldns 1.7.0 - CVE-2017-1000231/1000232\n");
    printf("  Port: %d/udp\n", PORT);
    printf("  Vuln: Heap overflow in ldns_wire2pkt()\n");
    printf("=====================================================\n\n");

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) { perror("socket"); exit(1); }

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("bind"); exit(1);
    }

    printf("[*] Listening on UDP port %d...\n\n", PORT);

    while (1) {
        ssize_t n = recvfrom(sockfd, buffer, sizeof(buffer), 0,
                             (struct sockaddr*)&client, &client_len);
        if (n <= 0) continue;

        printf("[*] Received %zd bytes from %s:%d\n",
               n, inet_ntoa(client.sin_addr), ntohs(client.sin_port));

        ldns_pkt *pkt = NULL;
        ldns_status status = ldns_wire2pkt(&pkt, buffer, (size_t)n);

        if (status == LDNS_STATUS_OK) {
            printf("[*] Parsed successfully\n");
            ldns_pkt_free(pkt);
        } else {
            printf("[!] Parse error: %s\n", ldns_get_errorstr_by_id(status));
        }
    }
    return 0;
}
EOF

RUN gcc -g -O0 -fno-stack-protector -z execstack -no-pie \
    -I/usr/include -L/usr/lib \
    -o server server.c -lldns

ENV LD_LIBRARY_PATH=/usr/lib
EXPOSE 5053/udp
CMD ["./server"]
