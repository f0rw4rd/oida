# FieldComm HART-IP Developer Kit with TLS-PSK (HART-IP v2)
# Based on hipserver + hipflowapp with PSK authentication enabled
# https://github.com/FieldCommGroup/hipflowapp

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    git \
    libssl-dev \
    libjsoncpp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 https://github.com/FieldCommGroup/hipflowapp.git
RUN git clone --depth 1 https://github.com/FieldCommGroup/hipserver.git

RUN rm -rf /src/hipflowapp/hipflowapp/Hip_Native/hipserver && \
    cp -r /src/hipserver /src/hipflowapp/hipflowapp/Hip_Native/hipserver

WORKDIR /src/hipflowapp/hipflowapp/Hip_Native/hipserver/hipserver/Server
RUN make clean 2>/dev/null || true && make

WORKDIR /src/hipflowapp/hipflowapp/Hip_Native
RUN make clean 2>/dev/null || true && make

# Runtime image
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    libssl3 \
    libjsoncpp25 \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /src/hipflowapp/hipflowapp/Hip_Native/hipserver/hipserver/Server/hipserver /app/
COPY --from=builder /src/hipflowapp/hipflowapp/Hip_Native/hipflowapp /app/

# Seed HART-IP v2 config with TLS-PSK credentials
# PSK identity: HART-IPClient
# PSK key: 7777772e68617274636f6d6d2e6f7267 (hex for "www.hartcomm.org")
RUN mkdir -p /var/lib/hipServer && \
    echo '{"slots":[{"clientIdentifier":"HART-IPClient","clientSecurityOptions":"1","key":"7777772e68617274636f6d6d2e6f7267","password":"!1HARTIPhighway","slot":"0"}],"supTCPPort":"0","supUDPPort":"0","syslogHOSTNAME":"","syslogIPPort":"514","syslogKey":"","syslogPassword":"","version":"2"}' \
    > /var/lib/hipServer/hipServer.conf

# Create startup script with -psk flag for TLS-PSK mode
RUN echo '#!/bin/bash\n\
echo "========================================"\n\
echo "HART-IP Server v2 (TLS-PSK)"\n\
echo "  UDP Port: ${HART_UDP_PORT:-5094}"\n\
echo "  TCP Port: $(( ${HART_UDP_PORT:-5094} + 1 )) (TLS-PSK)"\n\
echo "  PSK ID:   HART-IPClient"\n\
echo "========================================"\n\
exec /app/hipserver -p ${HART_UDP_PORT:-5094} -psk /app/hipflowapp\n\
' > /app/start.sh && chmod +x /app/start.sh

EXPOSE 5094/udp
EXPOSE 5094/tcp
EXPOSE 5095/tcp

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s \
    CMD nc -zu localhost 5094 || exit 1

CMD ["/app/start.sh"]
