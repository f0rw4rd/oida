# CAN Bus Mock Server using python-can UDP multicast interface
# Simulates a realistic CAN bus with UDS ECUs, OBD-II, CANopen nodes, and XCP/CCP slaves
# No kernel modules or host networking required — uses UDP multicast (239.0.0.1:43113)

FROM python:3.11-slim

RUN pip install --no-cache-dir python-can==4.4.2

COPY can_server.py /app/can_server.py

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV CAN_MULTICAST_PORT=43113

# UDP multicast port for python-can udp_multicast interface
EXPOSE 43113/udp

HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=5s \
    CMD python3 -c "import socket; s=socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(2); s.bind(('', 0)); s.sendto(b'ping', ('239.0.0.1', 43113)); s.close()"

ENTRYPOINT ["python3", "/app/can_server.py"]
