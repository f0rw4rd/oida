# Debian (glibc) base: vsftpd 3.0.x SIGSEGVs spontaneously on Alpine/musl
# (crash-loops within ~30s with no clients). glibc vsftpd is stable.
FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends vsftpd netcat-openbsd && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -d /home/ftpuser ftpuser && \
    echo "ftpuser:password" | chpasswd && \
    mkdir -p /var/run/vsftpd/empty
COPY ftp/vsftpd.conf /etc/vsftpd/vsftpd.conf
EXPOSE 21
CMD ["vsftpd", "/etc/vsftpd/vsftpd.conf"]
