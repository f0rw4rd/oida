# Makefile for EtherCAT Mock Slave
# Usage: make -f Makefile.ethercat

CC = gcc
CFLAGS = -Wall -Wextra -O2 -std=c99 -D_GNU_SOURCE
LDFLAGS = -lm

TARGET = ethercat_slave
SRCS = ethercat_slave.c
OBJS = $(SRCS:.c=.o)

.PHONY: all clean install debug

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "[+] Built $(TARGET)"

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

debug: CFLAGS += -g -DDEBUG
debug: clean all

clean:
	rm -f $(OBJS) $(TARGET)
	@echo "[+] Cleaned"

install: $(TARGET)
	install -m 755 $(TARGET) /usr/local/bin/
	@echo "[+] Installed to /usr/local/bin/$(TARGET)"

# Run with capabilities (alternative to sudo)
setcap:
	sudo setcap cap_net_raw,cap_net_admin+eip $(TARGET)
	@echo "[+] Set capabilities on $(TARGET)"
