FROM node:20-alpine AS builder

WORKDIR /app

# Install openssl for TLS cert generation at runtime
RUN apk add --no-cache openssl

# Copy package files and install dependencies
COPY package.json /app/
RUN npm install --omit=dev --ignore-scripts

# ---------- runtime ----------
FROM node:20-alpine

WORKDIR /app

# openssl needed at runtime for self-signed cert generation when TLS enabled
RUN apk add --no-cache openssl

# Copy node_modules from builder stage
COPY --from=builder /app/node_modules /app/node_modules

# Copy server script
COPY hl7_node_server.js /app/

# Expose MLLP port
EXPOSE 2576

# Health check: verify TCP port is listening
HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=5s \
  CMD node -e "const s=require('net').createConnection({port:2576,timeout:2000});s.on('connect',()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1))"

# Run server
CMD ["node", "hl7_node_server.js"]
