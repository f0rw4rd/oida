# REAL CVE-2017-11104 - Actual vulnerable Knot DNS v2.6.0
#
# This builds the real libknot library at the vulnerable version
# and links against it. The crash happens in library code.
#
# CVE-2017-11104: Heap buffer overflow in TSIG handling

FROM debian:bullseye

RUN apt-get update && apt-get install -y \
    git build-essential autoconf automake libtool pkg-config \
    liburcu-dev libgnutls28-dev libedit-dev liblmdb-dev libcap-ng-dev \
    libfstrm-dev libprotobuf-c-dev protobuf-c-compiler libjansson-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone Knot DNS and checkout vulnerable version 2.6.0
RUN git clone https://gitlab.nic.cz/knot/knot-dns.git && \
    cd knot-dns && \
    git checkout v2.6.0 && \
    autoreconf -if && \
    ./configure --prefix=/usr \
                --disable-daemon \
                --disable-utilities \
                --enable-debug \
                CFLAGS="-g -O0 -fno-stack-protector" && \
    make -j$(nproc) && \
    make install && \
    ldconfig

WORKDIR /app
RUN cat > server.c << 'EOF'
/**
 * DNS Server using libknot 2.6.0 (CVE-2017-11104)
 * Vulnerability is in the REAL libknot library
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <libknot/libknot.h>

#define PORT 5058

int main(void) {
    int sockfd;
    struct sockaddr_in addr, client;
    socklen_t client_len = sizeof(client);
    uint8_t buffer[65535];

    setbuf(stdout, NULL);
    printf("=====================================================\n");
    printf("  REAL Knot DNS 2.6.0 - CVE-2017-11104\n");
    printf("  Port: %d/udp\n", PORT);
    printf("  Vuln: Heap overflow in TSIG handling\n");
    printf("=====================================================\n\n");

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) { perror("socket"); exit(1); }

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("bind"); exit(1);
    }

    printf("[*] Listening on UDP port %d...\n\n", PORT);

    while (1) {
        ssize_t n = recvfrom(sockfd, buffer, sizeof(buffer), 0,
                             (struct sockaddr*)&client, &client_len);
        if (n <= 0) continue;

        printf("[*] Received %zd bytes from %s:%d\n",
               n, inet_ntoa(client.sin_addr), ntohs(client.sin_port));

        knot_pkt_t *pkt = knot_pkt_new(buffer, n, NULL);
        if (pkt) {
            int ret = knot_pkt_parse(pkt, 0);
            printf("[*] knot_pkt_parse: %d\n", ret);
            knot_pkt_free(&pkt);
        }
    }
    return 0;
}
EOF

RUN gcc -g -O0 -fno-stack-protector -z execstack -no-pie \
    -o server server.c $(pkg-config --cflags --libs libknot)

ENV LD_LIBRARY_PATH=/usr/lib
EXPOSE 5058/udp
CMD ["./server"]
