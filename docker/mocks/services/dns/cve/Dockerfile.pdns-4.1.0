# PowerDNS Recursor 4.1.0 - CVE-2018-1000003
# Unbounded memory allocation via CNAME/DNAME loops
# Reference: https://nvd.nist.gov/vuln/detail/CVE-2018-1000003
#
# Uses REAL vulnerable PowerDNS Recursor 4.1.0 from Debian repos
# The vulnerability is in the pdns_recursor binary itself
#
# For authorized security testing only

FROM debian:buster

# Use archive repos for old Debian buster
RUN echo "deb http://archive.debian.org/debian buster main" > /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian-security buster/updates main" >> /etc/apt/sources.list && \
    apt-get update && apt-get install -y --allow-unauthenticated \
    pdns-recursor \
    dnsutils \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Check version (should be 4.0.x or 4.1.x)
RUN pdns_recursor --version || true

# Create vulnerable configuration
RUN cat > /etc/powerdns/recursor.conf << 'EOF'
# PowerDNS Recursor - CVE-2018-1000003 vulnerable config
local-address=0.0.0.0
local-port=5057
allow-from=0.0.0.0/0

# Vulnerable settings - no limits
max-cache-entries=10000000
max-packetcache-entries=5000000
max-recursion-depth=100

# Logging
loglevel=6
trace=yes
quiet=no

# Disable security features
dnssec=off
EOF

RUN cat > /start.sh << 'SCRIPT'
#!/bin/sh
echo "=============================================="
echo "  PowerDNS Recursor 4.x - CVE-2018-1000003"
echo "=============================================="
echo "  Port: 5057/udp"
echo "  Binary: pdns_recursor (vulnerable)"
echo "  Vuln: Memory exhaustion via CNAME chain"
echo "  Trigger: Deep CNAME resolution loop"
echo "=============================================="
exec pdns_recursor --daemon=no --write-pid=no
SCRIPT
RUN chmod +x /start.sh

EXPOSE 5057/tcp
EXPOSE 5057/udp

CMD ["/start.sh"]
