# REAL CVE-2023-32067 - Actual vulnerable c-ares v1.19.0
#
# This builds the real c-ares library at the vulnerable version
# and links against it. The crash happens in library code.
#
# CVE-2023-32067: 0-length UDP causes denial of service

FROM debian:bullseye

RUN apt-get update && apt-get install -y \
    git build-essential cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone c-ares and checkout vulnerable version 1.19.0
RUN git clone https://github.com/c-ares/c-ares.git && \
    cd c-ares && \
    git checkout cares-1_19_0 && \
    cmake -DCMAKE_BUILD_TYPE=Debug \
          -DCMAKE_C_FLAGS="-g -O0 -fno-stack-protector" \
          -DCMAKE_INSTALL_PREFIX=/usr \
          . && \
    make -j$(nproc) && \
    make install && \
    ldconfig

WORKDIR /app
RUN cat > server.c << 'EOF'
/**
 * DNS Resolver using c-ares 1.19.0 (CVE-2023-32067)
 * Vulnerability is in the REAL c-ares library
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <ares.h>

#define PORT 5054

int main(void) {
    int sockfd;
    struct sockaddr_in addr, client;
    socklen_t client_len = sizeof(client);
    unsigned char buffer[65535];

    setbuf(stdout, NULL);
    printf("=====================================================\n");
    printf("  REAL c-ares 1.19.0 - CVE-2023-32067\n");
    printf("  Port: %d/udp\n", PORT);
    printf("  Vuln: DoS on 0-length or malformed packet\n");
    printf("=====================================================\n\n");

    if (ares_library_init(ARES_LIB_INIT_ALL) != ARES_SUCCESS) {
        fprintf(stderr, "ares_library_init failed\n");
        exit(1);
    }

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) { perror("socket"); exit(1); }

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(PORT);

    if (bind(sockfd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("bind"); exit(1);
    }

    printf("[*] Listening on UDP port %d...\n\n", PORT);

    while (1) {
        ssize_t n = recvfrom(sockfd, buffer, sizeof(buffer), 0,
                             (struct sockaddr*)&client, &client_len);

        printf("[*] Received %zd bytes from %s:%d\n",
               n, inet_ntoa(client.sin_addr), ntohs(client.sin_port));

        struct hostent *host = NULL;
        struct ares_addrttl ttls[16];
        int nttls = 16;

        int status = ares_parse_a_reply(buffer, (int)n, &host, ttls, &nttls);
        printf("[*] ares_parse_a_reply: %s\n", ares_strerror(status));

        if (host) ares_free_hostent(host);
    }

    ares_library_cleanup();
    return 0;
}
EOF

RUN gcc -g -O0 -fno-stack-protector -z execstack -no-pie \
    -o server server.c $(pkg-config --cflags --libs libcares)

ENV LD_LIBRARY_PATH=/usr/lib
EXPOSE 5054/udp
CMD ["./server"]
