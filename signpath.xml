<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows release archive.

  The CI uploads the whole `oida-<version>-windows-x86_64.zip`; SignPath performs
  deep/nested signing: it opens the zip, Authenticode-signs the declared PE
  file(s) from the inside out, and re-packages the zip.

  We sign only `oida/oida.exe` — that is the executable Windows checks at run
  time (SmartScreen/UAC), and signing the dozens of bundled .dll/.pyd under
  _internal/ would consume far more signatures for no user-visible trust gain.
  To sign them too, uncomment the <for-each> blocks below.

  Upload this file to your SignPath project as an Artifact Configuration and
  reference its slug via `artifact-configuration-slug` in the workflow.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="oida/oida.exe">
      <authenticode-sign/>
    </pe-file>

    <!-- Optional: also sign every bundled native library (more thorough,
         many more signatures). Uncomment to enable.
    <for-each pattern="oida/_internal/**/*.dll">
      <pe-file>
        <authenticode-sign/>
      </pe-file>
    </for-each>
    <for-each pattern="oida/_internal/**/*.pyd">
      <pe-file>
        <authenticode-sign/>
      </pe-file>
    </for-each>
    -->
  </zip-file>
</artifact-configuration>
