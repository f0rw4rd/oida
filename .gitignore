# Claude Code local machine-specific settings — keep local
.claude/settings.local.json

# Internal review artifacts — enumerate findings/vulns; keep LOCAL, never ship
CODE_REVIEW.md
TEST_GAP_AUDIT.md
.review-tmp/

# Per-protocol research material — kept local
ref/

# Per-developer pyenv pin — uv/CI manage the interpreter; don't force a version
.python-version

# direnv local env — kept local
.envrc

# Private registry URL for mock-image push/pull — keep LOCAL, never commit.
# Template lives at docker/mocks/.env.example (committed).
.env
docker/mocks/.env

# Fuzz session / scan databases. This was previously 13 individually-named
# files, each added after a new stray .db appeared — and it still missed
# ftp_t.db. One rule instead of a growing list of special cases.
# No .db file in this repo is source; the only checked-in data is JSON/CSV.
*.db
# SQLite WAL/SHM sidecars — never source
*.db-wal
*.db-shm
boofuzz-results/

# Agent/session scratch. NOT a blanket `.claude/` ignore: agent and workflow
# definitions under .claude/agents/ and .claude/workflows/ are versioned on
# purpose (19 tracked files). Only the per-session transient state is ignored.
.claude/projects/
.claude/scheduled_tasks.lock
.claude-work/
tmp.*
/results/
# Scan output / findings — may contain credentials or capture data, keep local
findings/
# Working notes / task scratch — kept local
tasks/
SLOP_CHECK_TODO.md
# Fuzzer crash dumps
/crashes/

# KNX hash-extraction inner-zip outputs (extract_knxproj_hash fallback path)
/P-*.zip

# Real-coverage suite per-run output (Axis 1: scanner field-coverage).
# Manifest files are run artefacts, not source.
tests/coverage/results/*.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

