#!/usr/bin/env python3
"""Block files that look like they contain secrets or credentials.

Checks staged files against a set of high-signal patterns for API keys,
tokens, and private keys. Not a replacement for a full secret scanner —
catches the obvious cases before they leave the developer's machine.
"""
import re
import sys

# (pattern, label) — ordered from highest to lowest signal
PATTERNS = [
    (r"-----BEGIN (?:RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY-----", "private key"),
    (r"AKIA[0-9A-Z]{16}", "AWS access key ID"),
    (r"(?i)aws[_-]?secret[_-]?access[_-]?key\s*[:=]\s*[\"']?[A-Za-z0-9/+=]{40}", "AWS secret key"),
    (r"ghp_[A-Za-z0-9]{36}", "GitHub classic PAT"),
    (r"github_pat_[A-Za-z0-9_]{82}", "GitHub fine-grained PAT"),
    (r"pypi-[A-Za-z0-9_\-]{40,}", "PyPI API token"),
    (r"(?i)(?:api[_-]?key|secret[_-]?key|access[_-]?token)\s*[:=]\s*[\"']?[A-Za-z0-9_\-]{32,}", "API/secret key"),
    (r"(?i)password\s*[:=]\s*[\"'][^\"']{12,}[\"']", "hardcoded password"),
]

SKIP_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".gif", ".ico", ".svg",
    ".whl", ".tar.gz", ".pdf", ".lock", ".bin", ".exe",
}

failed = False
for path in sys.argv[1:]:
    if any(path.endswith(ext) for ext in SKIP_EXTENSIONS):
        continue
    try:
        content = open(path, encoding="utf-8", errors="ignore").read()
    except OSError:
        continue
    for pattern, label in PATTERNS:
        if re.search(pattern, content):
            print(f"BLOCKED: {path} — probable {label} detected")
            failed = True
            break

if failed:
    print("\nRemove credentials from the file or move them to a .env (gitignored) before committing.")
    sys.exit(1)
