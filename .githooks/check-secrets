#!/usr/bin/env python3
"""Block files that look like they contain secrets or credentials.

Checks staged files against a set of high-signal patterns for API keys,
tokens, and private keys. Not a replacement for a full secret scanner —
catches the obvious cases before they leave the developer's machine.
"""

import re
import sys

# (pattern, label) — ordered from highest to lowest signal.
# The hardcoded-password pattern stays on ONE line ([ \t], value can't span
# \n): the old \s* form let a comment mentioning "password:" bridge across a
# newline into an unrelated quoted string on the next line, false-positiving
# on e.g. telnet.py's extraction comments.
PASSWORD_PATTERN = re.compile(r"(?i)password[ \t]*[:=][ \t]*[\"']([^\"'\n]{12,})[\"']")
# SCREAMING_CASE = "snake_case" is the enum/constant idiom (an enum whose
# string value mirrors its own constant name) — it is not a secret. Real
# passwords carry symbols, mixed case, or spaces and stay flagged; lowercase
# names stay flagged regardless.
CONSTANT_IDIOM = re.compile(r"\s*([A-Za-z_][A-Za-z0-9_]*)[ \t]*[:=][ \t]*[\"'][^\"'\n]+[\"']\s*")
IDENTIFIER_VALUE = re.compile(r"[a-z0-9_]+")
# A value that is nothing but an f-string placeholder is a variable being
# printed, not a literal — `f"password: '{display_pass}'"` reports a password
# OIDA just DISCOVERED on a target, which is the tool's whole job. There is no
# literal here to leak. Only a lone placeholder qualifies: anything with
# characters outside the braces ("hunter2{x}") stays flagged.
INTERPOLATION_ONLY = re.compile(r"\{[^{}]+\}")

PATTERNS = [
    (r"-----BEGIN (?:RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY-----", "private key"),
    (r"AKIA[0-9A-Z]{16}", "AWS access key ID"),
    (r"(?i)aws[_-]?secret[_-]?access[_-]?key\s*[:=]\s*[\"']?[A-Za-z0-9/+=]{40}", "AWS secret key"),
    (r"ghp_[A-Za-z0-9]{36}", "GitHub classic PAT"),
    (r"github_pat_[A-Za-z0-9_]{82}", "GitHub fine-grained PAT"),
    (r"pypi-[A-Za-z0-9_\-]{40,}", "PyPI API token"),
    (
        r"(?i)(?:api[_-]?key|secret[_-]?key|access[_-]?token)\s*[:=]\s*[\"']?[A-Za-z0-9_\-]{32,}",
        "API/secret key",
    ),
    ("__password__", "hardcoded password"),  # replaced by scan below, keeps order
]

SKIP_EXTENSIONS = {
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".svg",
    ".whl",
    ".tar.gz",
    ".pdf",
    ".lock",
    ".bin",
    ".exe",
}


def password_hits(content: str):
    """Candidate hardcoded passwords, minus enum/constant idioms."""
    hits = []
    for m in PASSWORD_PATTERN.finditer(content):
        val = m.group(1)
        line_start = content.rfind("\n", 0, m.start()) + 1
        nl = content.find("\n", m.end())
        line = content[line_start : nl if nl != -1 else len(content)]
        full = CONSTANT_IDIOM.fullmatch(line)
        if full and full.group(1).isupper() and IDENTIFIER_VALUE.fullmatch(val):
            continue
        if INTERPOLATION_ONLY.fullmatch(val):
            continue
        hits.append(val)
    return hits


failed = False
for path in sys.argv[1:]:
    if any(path.endswith(ext) for ext in SKIP_EXTENSIONS):
        continue
    try:
        content = open(path, encoding="utf-8", errors="ignore").read()
    except OSError:
        continue
    for pattern, label in PATTERNS:
        if label == "hardcoded password":
            continue  # handled after the simple loop
        if re.search(pattern, content):
            print(f"BLOCKED: {path} — probable {label} detected")
            failed = True
            break
    hits = password_hits(content)
    if hits:
        shown = hits[0] if len(hits[0]) <= 20 else hits[0][:17] + "..."
        print(f"BLOCKED: {path} — probable hardcoded password detected ({shown})")
        failed = True

if failed:
    print(
        "\nRemove credentials from the file or move them to a .env (gitignored) before committing."
    )
    sys.exit(1)
