    {
      "code": "01",
      "function": "Read Coils",
      "area": "Mapped BOOL tags"
    },
    {
      "code": "02",
      "function": "Read Discrete Inputs",
      "area": "Mapped BOOL input tags"
    },
    {
      "code": "03",
      "function": "Read Holding Registers",
      "area": "Mapped numeric tags"
    },
    {
      "code": "04",
      "function": "Read Input Registers",
      "area": "Mapped input tags"
    },
    {
      "code": "05",
      "function": "Write Single Coil",
      "area": "Mapped BOOL tags"
    },
    {
      "code": "06",
      "function": "Write Single Register",
      "area": "Mapped numeric tags"
    },
    {
      "code": "15",
      "function": "Write Multiple Coils",
      "area": "Mapped BOOL tags"
    },
    {
      "code": "16",
      "function": "Write Multiple Registers",
      "area": "Mapped numeric tags"
    }
  ],
  "registers": {
    "example_int_tag": {
      "address": 0,
      "type": "i16",
      "access": "rw",
      "description": "Example: User INT tag mapped to holding register 40001 via CCW"
    },
    "example_dint_tag": {
      "address": 2,
      "type": "i32",
      "access": "rw",
      "description": "Example: User DINT tag mapped to registers 40003-40004"
    },
    "example_real_tag": {
      "address": 4,
      "type": "f32",
      "access": "rw",
      "description": "Example: User REAL tag mapped to registers 40005-40006"
    }
  },
  "coils": {
    "example_bool_tag": {
      "address": 0,
      "access": "rw",
      "description": "Example: User BOOL tag mapped to coil 00001 via CCW"
    }
  },
