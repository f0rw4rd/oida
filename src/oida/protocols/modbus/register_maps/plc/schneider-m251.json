  "vendor": "Schneider Electric",
  "model": "Modicon M251 (TM251)",
  "description": "Schneider Modicon M251/TM251 Logic Controller Modbus TCP register map",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 255,
  "notes": "M251 supports dual Ethernet ports with embedded Modbus TCP server. No configuration required for basic Modbus server functionality. Accessible in RUN, STOP, and EMPTY states.",
  "source": "https://product-help.schneider-electric.com/Machine%20Expert/V1.1/en/m251prg/m251prg/Ethernet_Configuration/Ethernet_Configuration-11.htm",
  "security_notes": {
    "protocol_clarification": "PIPEDREAM/Incontroller (2022) targeted M251 primarily via CODESYS protocol (UDP/1740), NOT Modbus. The M251 uses EcoStruxure Machine Expert which implements Codesys. Modbus TCP server is secondary attack surface.",
    "modbus_attack_vectors": [
      "Memory read via FC3/FC4 for reconnaissance",
      "Memory write via FC6/FC16 for data manipulation",
      "I/O control via Slave Device mapped registers"
    ],
    "documented_modbus_attacks": "No documented real-world Modbus-only attacks on M251. PIPEDREAM used Codesys for primary attack vector.",
    "mitre_techniques": [
      "T0801",
      "T0802",
      "T0861"
    ]
  },
