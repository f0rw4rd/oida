    "03": "Read Holding Registers (%MW)",
    "04": "Read Input Registers (%MW)",
    "05": "Write Single Coil (%M bit)",
    "06": "Write Single Register (%MW)",
    "15": "Write Multiple Coils (%M bits)",
    "16": "Write Multiple Registers (%MW)"
  },
