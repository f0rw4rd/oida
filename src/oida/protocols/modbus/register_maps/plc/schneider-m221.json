{
  "vendor": "Schneider Electric",
  "model": "Modicon M221 (TM221)",
  "description": "Schneider Modicon M221/TM221 Logic Controller Modbus TCP register map",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 255,
  "notes": "M221 uses zero-based addressing. Physical I/O (%I/%Q) cannot be accessed directly via Modbus - only %M and %MW registers. High word first (big-endian) for 32-bit values.",
  "source": "https://www.se.com/us/en/faqs/FA308725/, https://infoneva.com/en/knowledge/confirming-modbus-tcp-offset-data-schneider-m221",
  "security_notes": {
    "protocol_clarification": "PIPEDREAM/Incontroller (2022) targeted M221 primarily via CODESYS protocol (UDP/1740), NOT Modbus. However, M221 does expose a Modbus TCP server that can be used for reconnaissance and data manipulation.",
    "modbus_attack_vectors": [
      "Memory read via FC3/FC4 for reconnaissance",
      "Memory write via FC6/FC16 for data manipulation",
      "Coil write via FC5/FC15 for output control"
    ],
    "documented_modbus_attacks": "No documented real-world Modbus-only attacks on M221. PIPEDREAM used Codesys for primary attack vector.",
    "mitre_techniques": [
      "T0801",
      "T0802",
      "T0861"
    ]
  },
  "function_codes": {
    "01": "Read Coils (%M bits)",
