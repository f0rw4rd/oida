      "type": "i32",
      "access": "r",
      "scale": 0.1,
      "unit": "V",
      "description": "Smart Meter: Average line-to-neutral voltage"
    },
    "meter_voltage_ll": {
      "address": 260,
      "type": "i32",
      "access": "r",
      "scale": 0.1,
      "unit": "V",
