{
  "vendor": "Fronius",
  "model": "Symo GEN24/Primo GEN24 + Smart Meter TS 65A-3",
  "description": "Fronius GEN24 hybrid inverters with Smart Meter. This map combines Smart Meter registers (258-327) and SunSpec inverter registers (40xxx).",
  "version": "1.1",
  "byte_order": "big",
  "word_order": "little",
  "default_unit_id": 1,
  "notes": "Smart Meter uses i32 with little word order at addresses 258-327. GEN24 inverter uses SunSpec float registers at 40xxx. Update rate: 1s realtime. RTU: 9600 baud, 8N1.",
  "source": "https://github.com/otti/FroniusModbusRtu (Smart Meter), https://github.com/oscarknapp/Fronius-Gen-24-Modbus-Integration (Inverter SunSpec)",
