{
  "vendor": "Danfoss",
  "model": "Vacon 20",
  "description": "Danfoss Vacon 20 Variable Frequency Drive Modbus RTU register map",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "Vacon 20 is a compact VFD supporting Modbus RTU via built-in RS-485 port. Same register structure as Vacon 100. Control Word is 16-bit. Speed reference 0-10000 = 0-100% of frequency range.",
  "source": "https://files.danfoss.com/download/Drives/Vacon-20-Modbus-User-Manual-DPD01925A-UK.pdf",
  "security_notes": {
    "protocol_clarification": "Stuxnet (2010) targeted VFDs via PROFIBUS, NOT Modbus. No documented real-world Modbus-based VFD attacks exist. This register map is for authorized penetration testing and defensive monitoring.",
    "theoretical_attack_vectors": [
      "Control word manipulation for motor start/stop/direction",
      "Speed reference modification (register 2002)",
      "Frequency limit tampering",
      "Ramp time manipulation for mechanical stress"
    ],
    "documented_modbus_attacks": "None. VFD attacks in Stuxnet used Profibus protocol.",
    "defensive_use": "Monitor registers 2001 (control word), 2002 (speed ref), 2101 (status) for unauthorized changes",
    "mitre_techniques": [
      "T0855",
      "T0831",
      "T0836"
    ]
  },
  "control_commands": {
    "run_forward": {
      "register": 2001,
      "value": "0x0001",
      "description": "Start motor forward"
    },
    "run_reverse": {
      "register": 2001,
      "value": "0x0003",
      "description": "Start motor reverse"
    },
    "stop": {
      "register": 2001,
      "value": "0x0000",
      "description": "Stop motor"
    },
    "fault_reset": {
      "register": 2001,
      "value": "0x0004",
      "description": "Reset fault"
    }
  },
  "coils": {
    "run_stop": {
      "address": 1,
      "type": "bool",
      "access": "rw",
      "description": "Control Word bit 0 - RUN/STOP"
    },
    "direction": {
      "address": 2,
      "type": "bool",
      "access": "rw",
      "description": "Control Word bit 1 - Direction"
    },
    "fault_reset": {
      "address": 3,
      "type": "bool",
      "access": "rw",
      "description": "Control Word bit 2 - Fault reset"
    },
    "ext_fault": {
      "address": 4,
      "type": "bool",
      "access": "rw",
      "description": "Control Word bit 3 - External fault"
    },
    "run_enable": {
      "address": 5,
      "type": "bool",
      "access": "rw",
      "description": "Control Word bit 4 - Run enable"
    },
