  "holding_registers": {
    "control_word": {
      "address": 2001,
      "type": "u16",
      "access": "rw",
      "description": "FB Control Word - Process Data IN 1",
      "bits": {
        "0": "RUN (1=Run, 0=Stop)",
        "1": "Direction (1=Reverse, 0=Forward)",
        "2": "Fault reset (rising edge)",
        "3": "External fault",
        "4": "Run enable",
        "5": "Reserved",
        "6": "PID setpoint 1",
        "7": "PID setpoint 2",
        "8": "Accel/Decel prohibit",
