      "access": "rw",
      "description": "Control Word bit 9 - Motor pot UP"
    },
    "motor_pot_down": {
      "address": 11,
      "type": "bool",
      "access": "rw",
      "description": "Control Word bit 10 - Motor pot DOWN"
    }
  },
