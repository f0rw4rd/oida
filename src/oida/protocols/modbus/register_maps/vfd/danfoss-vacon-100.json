{
  "vendor": "Danfoss",
  "model": "Vacon 100",
  "description": "Danfoss Vacon 100 Variable Frequency Drive Modbus TCP/RTU register map",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "Vacon 100 supports both Modbus RTU and TCP. Control Word is 32-bit. Speed reference 0-10000 = 0-100% of frequency range. Process Data IN/OUT registers used for real-time control.",
  "source": "https://files.danfoss.com/download/Drives/Vacon-100-Modbus-User-Manual-DPD00156C-UK.pdf",
  "security_notes": {
    "protocol_clarification": "Stuxnet (2010) targeted VFDs via PROFIBUS, NOT Modbus. No documented real-world Modbus-based VFD attacks exist. This register map is for authorized penetration testing and defensive monitoring.",
    "theoretical_attack_vectors": [
      "Control word manipulation for motor start/stop/direction",
      "Speed reference modification (register 2002)",
      "Frequency limit tampering",
      "Ramp time manipulation for mechanical stress"
    ],
    "documented_modbus_attacks": "None. VFD attacks in Stuxnet used Profibus protocol.",
    "defensive_use": "Monitor registers 2001 (control word), 2002 (speed ref), 2101 (status) for unauthorized changes",
    "mitre_techniques": [
      "T0855",
      "T0831",
      "T0836"
    ]
  },
  "control_commands": {
    "run_forward": {
      "register": 2001,
      "value": "0x0001",
      "description": "Start motor forward - set Control Word bit 0"
    },
    "run_reverse": {
      "register": 2001,
      "value": "0x0003",
      "description": "Start motor reverse - set Control Word bits 0 and 1"
    },
    "stop": {
      "register": 2001,
      "value": "0x0000",
      "description": "Stop motor - clear Control Word"
    },
    "fault_reset": {
      "register": 2001,
      "value": "0x0004",
      "description": "Reset fault - set Control Word bit 2"
    }
  },
  "coils": {
