{
  "vendor": "ABB",
  "model": "ACS880",
  "description": "ABB ACS880 Industrial Drive Modbus TCP/RTU register map",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "ACS880 supports ABB Drives profile and PROFIdrive profiles. Control Word at register 51, Status Word at register 4. Speed reference +/-20000 = +/-100% of Par 46.01 scaling. Requires FENA-01/FMBT-21 module for Modbus TCP.",
  "source": "https://www.manualslib.com/manual/1652328/Abb-Acs880.html, https://library.e.abb.com/public/4cc8232fa00c47e18685645c3b6b0f2d/LVD-EOTN142U-EN.pdf",
  "security_notes": {
    "protocol_clarification": "Stuxnet (2010) targeted VFDs via PROFIBUS, NOT Modbus. No documented real-world Modbus-based VFD attacks exist. ACS880 is widely deployed in critical infrastructure.",
    "theoretical_attack_vectors": [
      "Control word manipulation for motor start/stop/direction (register 51)",
      "Speed reference modification (register 52, +/-20000 scaling)",
      "Parameter tampering via holding registers",
      "Torque limit bypass"
    ],
    "documented_modbus_attacks": "None. VFD attacks in Stuxnet used Profibus protocol.",
    "defensive_use": "Monitor registers 51 (control word), 52 (speed ref), 4 (status) for unauthorized changes",
    "mitre_techniques": [
      "T0855",
      "T0831",
      "T0836"
    ]
  },
  "control_commands": {
    "run_forward": {
      "register": 51,
      "value": "0x047F",
      "description": "Start motor forward (ABB Drives profile)"
    },
    "run_reverse": {
      "register": 51,
      "value": "0x0C7F",
      "description": "Start motor reverse"
    },
    "stop_ramp": {
      "register": 51,
      "value": "0x047E",
      "description": "Stop with ramp"
    },
    "stop_coast": {
      "register": 51,
      "value": "0x0476",
      "description": "Coast stop"
    },
    "fault_reset": {
      "register": 51,
      "value": "0x04FF",
      "description": "Reset fault"
    },
    "emergency_stop": {
      "register": 51,
      "value": "0x0472",
      "description": "Emergency stop"
    }
  },
