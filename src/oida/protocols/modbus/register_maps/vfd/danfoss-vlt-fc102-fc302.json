{
  "vendor": "Danfoss",
  "model": "VLT FC102/FC302",
  "description": "Danfoss VLT HVAC Drive FC102 and AutomationDrive FC302 Variable Frequency Drive Modbus RTU/TCP register map",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "Parameter address formula: (Parameter_Group * 100 + Parameter_Number) * 10. Example: Parameter 16-14 = 1614 * 10 = 16140. For Modbus address, subtract 1. Some special registers (CTW, REF, STW, MAV) use fixed addresses 49999, 50009, 50199, 50209. Frequency scaling: 16384 = 100% = 50Hz nominal. FC Profile control word and status word used. All 16-bit values unless noted. 32-bit parameters occupy 2 registers.",
  "source": "https://files.danfoss.com/download/Drives/MG10S202.pdf, https://docs.webhmi.com.ua/danfoss_control",
  "fault_codes": {
    "2": "Live zero error - signal below 50% of minimum",
    "3": "No motor connected",
    "4": "Mains phase loss",
    "5": "DC link voltage high",
    "6": "DC link voltage low",
    "7": "DC overvoltage",
    "8": "DC undervoltage",
    "9": "Inverter overload",
    "10": "Motor ETR overtemperature",
    "11": "Motor thermistor overtemperature",
    "12": "Torque limit",
    "13": "Overcurrent",
    "14": "Ground fault",
    "15": "Serial communication timeout",
    "16": "Reserved",
    "17": "Control word timeout",
    "28": "Brake check fault",
    "29": "Heatsink temperature",
    "33": "Out of frequency range",
    "34": "Internal communication fault",
    "38": "Internal fault",
    "39": "Heatsink sensor",
    "40": "Safe stop activated",
    "48": "External interlock",
    "52": "Safe stop fault",
    "65": "Control card temperature"
  },
  "warning_codes": {
    "7": "DC overvoltage warning",
    "8": "DC undervoltage warning",
    "9": "Inverter overload warning",
    "10": "Motor ETR overtemp warning",
    "11": "Motor thermal warning",
    "12": "Current limit",
    "13": "Torque limit",
    "14": "Speed limit",
    "15": "Reference outside range",
    "25": "Brake resistor thermal warning",
    "29": "Heatsink temperature warning",
    "51": "AMA not OK"
  },
  "control_commands": {
    "start_forward": {
      "register": 49999,
      "value": "0x047F",
      "description": "Start motor forward (coast=1, run=1, data_valid=1, forward)"
    },
    "start_reverse": {
      "register": 49999,
      "value": "0x847F",
      "description": "Start motor reverse (coast=1, run=1, data_valid=1, reverse)"
    },
    "stop_ramp": {
      "register": 49999,
      "value": "0x0477",
      "description": "Stop with ramp down"
    },
    "stop_coast": {
      "register": 49999,
      "value": "0x0475",
      "description": "Coast stop (free wheel)"
    },
    "reset_fault": {
      "register": 49999,
      "value": "0x04FF",
      "description": "Reset fault (toggle bit 7)"
    },
    "jog_forward": {
      "register": 49999,
      "value": "0x057F",
      "description": "Jog forward"
    },
    "quick_stop": {
      "register": 49999,
      "value": "0x046F",
      "description": "Quick stop"
    }
  },
  "holding_registers": {
    "control_word": {
      "address": 49999,
      "type": "u16",
      "access": "rw",
      "description": "Control Word (CTW) - FC Profile",
      "notes": "Start/stop/direction control. Set parameter 8-10 to FC Profile.",
      "bits": {
        "0": "Reserved",
        "1": "Coasting stop (0=coast, 1=normal)",
        "2": "DC braking (0=DC brake, 1=normal)",
        "3": "Stop/run (0=stop, 1=run)",
        "4": "Quick stop (0=quick stop, 1=normal)",
        "5": "Freeze frequency (0=freeze, 1=normal)",
        "6": "Ramp stop/start (0=stop, 1=start)",
        "7": "Reset (leading edge resets trip)",
        "8": "Jog speed (0=normal, 1=jog)",
        "9": "Ramp 1/2 select",
        "10": "Data valid / Control word enable",
        "11": "Relay 1",
        "12": "Relay 2",
        "13": "Setup select LSB",
        "14": "Setup select MSB",
        "15": "Reversing (0=forward, 1=reverse)"
      }
    },
    "frequency_reference": {
      "address": 50009,
      "type": "s16",
      "access": "rw",
      "unit": "%",
      "scale": 0.0030517578125,
      "description": "Bus Reference (REF) - Frequency setpoint",
      "notes": "Range 0-16384 = 0-100% of max frequency. 16384 = 50Hz if nominal is 50Hz.",
      "min": -32768,
      "max": 32767
    },
    "status_word": {
      "address": 50199,
      "type": "u16",
      "access": "r",
      "description": "Status Word (STW) - FC Profile",
      "bits": {
        "0": "Control ready (1=ready)",
        "1": "Drive ready (1=ready to operate)",
        "2": "Coasting stop (1=coast command active)",
        "3": "Trip (0=no trip, 1=tripped)",
        "4": "Error (trip without lock)",
        "5": "Not used",
        "6": "Trip lock (1=locked)",
        "7": "Warning (1=warning active)",
        "8": "Speed == reference (1=at setpoint)",
        "9": "Bus control (1=fieldbus control active)",
        "10": "Frequency limit (1=at limit)",
        "11": "Running (1=motor running)",
        "12": "Voltage warn (1=DC bus warning)",
        "13": "Current limit (1=at current limit)",
        "14": "Thermal warning (1=thermal warn)",
        "15": "Reverse (1=reverse direction)"
      }
    },
    "actual_frequency": {
      "address": 50209,
      "type": "s16",
      "access": "r",
      "unit": "%",
      "scale": 0.0030517578125,
      "description": "Main Actual Value (MAV) - Actual output frequency",
      "notes": "Scaled same as reference: 16384 = 100%"
    },
