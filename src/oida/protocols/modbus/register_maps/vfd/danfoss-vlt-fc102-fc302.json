  "extended_info": {
    "parameter_formula": {
      "description": "Modbus address = (Parameter_Group * 100 + Parameter_Number) * 10 - 1",
      "example": "Parameter 16-14 (Motor Current) -> (16*100+14)*10 - 1 = 16139"
    },
    "scaling": {
      "frequency_reference": {
        "description": "0-16384 corresponds to 0-100% of maximum frequency",
        "multiplier": 0.0030517578125,
        "example": "16384 = 100% = 50Hz (if max freq = 50Hz)"
      },
      "percentage": {
        "description": "Values in 0.1% units",
        "multiplier": 0.1
      }
    }
  },
