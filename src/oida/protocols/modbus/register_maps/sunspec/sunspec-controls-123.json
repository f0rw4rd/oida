        "0": "DISCONNECT",
        "1": "CONNECT"
      }
    },
    "w_max_lim_pct": {
      "address": 5,
      "type": "u16",
      "access": "rw",
      "scale_factor_register": 23,
      "unit": "% WMax",
      "description": "Active power limit as % of WMax (WMaxLimPct)"
