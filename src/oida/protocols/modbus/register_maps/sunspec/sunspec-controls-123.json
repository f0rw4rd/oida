{
  "vendor": "SunSpec",
  "model": "Immediate Controls Model 123",
  "description": "SunSpec Model 123 - Immediate inverter controls for connect/disconnect, power limiting, and reactive power",
  "version": "1.0",
  "standard": "sunspec",
  "sunspec_model_id": 123,
  "base_address": 40000,
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "Model 123 = Immediate Controls. Model length is 24 registers. Contains writable registers for grid operator curtailment: connect/disconnect, active power limiting (WMaxLimPct), power factor setpoints, reactive power control. Security-critical for DER management. Addresses include 2-register header (ID+Length).",
  "source": "https://github.com/sunspec/models/blob/master/smdx/smdx_00123.xml",
  "registers": {
    "model_id": {
      "address": 0,
      "type": "u16",
      "access": "r",
      "description": "Model ID (123 = Immediate Controls)"
    },
    "model_length": {
      "address": 1,
      "type": "u16",
      "access": "r",
      "description": "Model length (24 registers)"
    },
    "conn_win_tms": {
      "address": 2,
      "type": "u16",
      "access": "rw",
      "unit": "s",
      "description": "Time window for connect/disconnect (Conn_WinTms)"
    },
    "conn_rvrt_tms": {
      "address": 3,
      "type": "u16",
      "access": "rw",
      "unit": "s",
      "description": "Timeout for connect/disconnect revert (Conn_RvrtTms)"
    },
    "conn": {
      "address": 4,
      "type": "u16",
      "access": "rw",
      "description": "Connect/disconnect inverter (Conn)",
