      "type": "s16",
      "access": "rw",
      "unit": "C",
      "scale": 0.1,
      "description": "Room temperature setpoint (0.1C resolution)",
      "min": 50,
      "max": 350,
      "notes": "Primary attack target - reducing this disables heating"
    },
    "supply_temp_setpoint": {
      "address": 1,
      "type": "s16",
      "access": "rw",
      "unit": "C",
      "scale": 0.1,
