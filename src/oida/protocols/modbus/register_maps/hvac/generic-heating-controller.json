{
  "vendor": "Generic",
  "model": "HVAC Heating Controller",
  "description": "Generic HVAC/Building heating controller Modbus TCP register map - FrostyGoop attack pattern template",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "Generic register map for HVAC heating controllers based on FrostyGoop (2024) attack patterns. Covers common heating control registers including temperature setpoints, mode control, and valve/pump outputs. Applicable to district heating, building management, and residential heating systems.",
  "source": "Based on FrostyGoop malware analysis (Dragos, Unit42) and common HVAC Modbus implementations",
  "security_notes": {
    "verified_attack": "FrostyGoop (Jan 2024, Lviv Ukraine) is the ONLY documented real-world ICS malware using Modbus TCP as primary attack vector",
    "attack_details": {
      "date": "January 22-23, 2024",
      "target": "Municipal district energy company, Lviv, Ukraine",
      "impact": "600+ apartment buildings lost heating for 2 days in sub-zero temperatures",
      "method": "Modbus FC3 (read), FC6 (write single), FC16 (write multiple) to ENCO controllers",
      "target_registers": [53370, 53882, 53760, 54272]
    },
    "verified_iocs": {
      "sha256_samples": [
        "5d2e4fd08f81e3b2eb2f3eaae16eb32ae02e760afc36fa17f4649322f6da53fb",
        "a63ba88ad869085f1625729708ba65e87f5b37d7be9153b3db1a1b0e3fed309c"
      ],
      "yara_rule": "MAL_Go_Modbus_Jul24_1 by Florian Roth",
      "virustotal": "https://www.virustotal.com/gui/file/5d2e4fd08f81e3b2eb2f3eaae16eb32ae02e760afc36fa17f4649322f6da53fb"
    },
    "attack_vectors": [
      "Temperature setpoint manipulation to disable heating",
      "Operating mode changes (heat/cool/off)",
      "Valve position manipulation",
      "Firmware downgrade on controllers"
    ],
    "mitre_techniques": ["T0855", "T0831", "T0836", "T0879"],
    "impact": "Loss of heating in critical infrastructure can cause physical harm, pipe freezing, and property damage"
  },
  "holding_registers": {
    "room_temp_setpoint": {
