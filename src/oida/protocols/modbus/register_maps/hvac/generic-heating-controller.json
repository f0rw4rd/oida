  "attack_patterns": {
    "frostygoop_heating_disable": {
      "description": "FrostyGoop attack pattern to disable heating",
      "steps": [
        "1. Write 0 (Off) to operating_mode (HR 3)",
        "2. Write 0 to room_temp_setpoint (HR 0)",
        "3. Write 0 to control_enable (HR 14)",
        "4. Write 0% to valve_position_setpoint (HR 5)"
      ]
    },
    "frost_protection_bypass": {
      "description": "Disable frost protection to cause pipe freezing",
      "steps": [
        "1. Write 0 to frost_protection_enable (Coil 4)",
        "2. Write -100 (-10C) to frost_protection_temp (HR 11)"
      ]
    },
    "sensor_spoofing": {
      "description": "Spoof sensor readings to mask attack",
      "target": "If controller accepts sensor value writes"
    }
  },
