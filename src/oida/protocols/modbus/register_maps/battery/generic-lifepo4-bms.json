    },
    "cell_voltage_15": {
      "address": 114,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 15 voltage"
    },
    "cell_voltage_16": {
      "address": 115,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 16 voltage"
    },
    "temp_sensor_1": {
      "address": 200,
      "type": "i16",
      "access": "r",
      "unit": "C",
      "scale": 0.1,
      "description": "Temperature sensor 1"
    },
    "temp_sensor_2": {
      "address": 201,
      "type": "i16",
      "access": "r",
      "unit": "C",
      "scale": 0.1,
      "description": "Temperature sensor 2"
    },
    "temp_sensor_3": {
      "address": 202,
      "type": "i16",
      "access": "r",
      "unit": "C",
      "scale": 0.1,
      "description": "Temperature sensor 3"
    },
    "temp_sensor_4": {
      "address": 203,
      "type": "i16",
      "access": "r",
      "unit": "C",
      "scale": 0.1,
      "description": "Temperature sensor 4"
    }
  }
}
