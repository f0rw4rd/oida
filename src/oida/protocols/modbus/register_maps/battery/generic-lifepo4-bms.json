      "description": "Cell 4 voltage"
    },
    "cell_voltage_5": {
      "address": 104,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 5 voltage"
    },
    "cell_voltage_6": {
      "address": 105,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 6 voltage"
    },
    "cell_voltage_7": {
      "address": 106,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 7 voltage"
    },
    "cell_voltage_8": {
      "address": 107,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 8 voltage"
    },
    "cell_voltage_9": {
      "address": 108,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 9 voltage"
    },
    "cell_voltage_10": {
      "address": 109,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 10 voltage"
    },
    "cell_voltage_11": {
      "address": 110,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 11 voltage"
    },
    "cell_voltage_12": {
      "address": 111,
      "type": "u16",
      "access": "r",
      "unit": "mV",
      "description": "Cell 12 voltage"
    },
    "cell_voltage_13": {
      "address": 112,
