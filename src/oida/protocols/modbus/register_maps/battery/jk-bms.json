{
  "vendor": "JK-BMS (Jikong)",
  "model": "JK-B Series LiFePO4 BMS",
  "description": "JK-BMS (Jikong) battery management system with Modbus RTU via RS485",
  "version": "1.0",
  "byte_order": "big",
  "word_order": "big",
  "default_unit_id": 1,
  "notes": "JK-BMS RS485 Modbus V1.1 protocol. Default baud: 115200, 8N1. Supports up to 24 cells. Cell voltages at 0x1200+, temperatures at 0x1300+. Input registers (FC04).",
  "source": "https://github.com/syssi/esphome-jk-bms (BMS RS485 Modbus V1.1.pdf)",
  "registers": {
    "pack_voltage": {
      "address": 0,
      "type": "u16",
      "access": "r",
      "unit": "V",
      "scale": 0.01,
      "description": "Total pack voltage"
    },
    "pack_current": {
      "address": 1,
      "type": "i16",
      "access": "r",
      "unit": "A",
      "scale": 0.01,
      "description": "Pack current (positive = discharge)"
    },
    "remaining_capacity": {
      "address": 2,
      "type": "u16",
      "access": "r",
      "unit": "Ah",
      "scale": 0.01,
      "description": "Remaining capacity"
    },
    "nominal_capacity": {
      "address": 3,
      "type": "u16",
      "access": "r",
      "unit": "Ah",
      "scale": 0.01,
      "description": "Nominal capacity"
    },
    "cycle_count": {
      "address": 4,
      "type": "u16",
      "access": "r",
      "description": "Cycle count"
    },
    "production_date": {
      "address": 5,
      "type": "u16",
      "access": "r",
      "description": "Production date (packed format)"
    },
    "balance_current": {
      "address": 6,
      "type": "u16",
      "access": "r",
      "unit": "mA",
      "description": "Balance current"
    },
    "errors": {
      "address": 7,
      "type": "u16",
      "access": "r",
      "description": "Error bits (bitfield)"
    },
    "software_version": {
      "address": 8,
      "type": "u16",
      "access": "r",
      "description": "Software version"
    },
    "soc": {
      "address": 9,
      "type": "u16",
      "access": "r",
      "unit": "%",
      "description": "State of charge"
    },
    "mosfet_status": {
      "address": 10,
      "type": "u16",
      "access": "r",
      "description": "MOSFET status (bit0=charge, bit1=discharge)"
    },
    "cell_count": {
      "address": 11,
      "type": "u16",
      "access": "r",
      "description": "Number of cells"
    },
    "temp_count": {
      "address": 12,
      "type": "u16",
      "access": "r",
      "description": "Number of temperature sensors"
    },
    "temp_1": {
      "address": 13,
      "type": "u16",
      "access": "r",
      "unit": "C",
      "scale": 0.1,
